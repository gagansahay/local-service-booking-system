# =====================================================================
#  Local Service Booking & Management System -- BCSP-064
# =====================================================================

# ---- Secrets --------------------------------------------------------
# Real credentials live here and must never be committed.
# Copy .env.example to .env and fill that in instead.
.env
.env.*
!.env.example

# ---- User-uploaded content ------------------------------------------
# Profile photos are runtime data, not source. The directory itself is
# kept (via .gitkeep) so the application has somewhere to write.
assets/uploads/*
!assets/uploads/.gitkeep

# ---- Personal and academic documents --------------------------------
# The signed approval proforma, the student ID card and the synopsis
# contain personal information (address, phone, signature, enrolment
# number). They belong in the submitted report, never in a Git repo.
*.pdf
*.jpg
*.jpeg
*.png
!assets/images/*

# ---- Editor and OS noise --------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# ---- Logs and temporary files ---------------------------------------
*.log
/tmp/
