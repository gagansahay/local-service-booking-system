# =====================================================================
#  Line-ending policy
# ---------------------------------------------------------------------
#  Everything is stored in the repository with LF endings.
#
#  This matters for deployment: the Dockerfile and docker-compose file
#  are interpreted inside a Linux container, and CRLF endings can break
#  multi-line shell blocks there. Normalising at the repository level
#  means it does not matter that development happens on Windows.
# =====================================================================

* text=auto eol=lf

# Files that must always be LF, regardless of platform.
Dockerfile        text eol=lf
*.yaml            text eol=lf
*.yml             text eol=lf
*.sh              text eol=lf
*.php             text eol=lf
*.sql             text eol=lf
*.css             text eol=lf
*.js              text eol=lf
*.md              text eol=lf

# Binary assets: never touch these.
*.png             binary
*.jpg             binary
*.jpeg            binary
*.webp            binary
*.pdf             binary
*.ico             binary
