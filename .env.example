# =====================================================================
#  Local Service Booking & Management System -- BCSP-064
#  Environment template
# ---------------------------------------------------------------------
#  Copy this file to .env and fill in real values.
#  .env is git-ignored, so secrets never reach the repository.
#
#  For LOCAL XAMPP development you do NOT need any of this -- with no
#  variables set, the application falls back to 127.0.0.1 / root / no
#  password, which is the XAMPP default.
# =====================================================================

# ---- Database -------------------------------------------------------
# In Docker, DB_HOST is the compose service name, not localhost.
DB_HOST=db
DB_PORT=3306

# Must stay lsbms_db: database/lsbms_schema.sql creates that name.
DB_NAME=lsbms_db

DB_USER=lsbms
DB_PASSWORD=change-this-to-a-long-random-password

# ---- Database container ---------------------------------------------
# Read by docker-compose.yaml when it creates the MySQL container.
MYSQL_ROOT_PASSWORD=change-this-to-a-different-long-random-password
MYSQL_USER=lsbms
MYSQL_PASSWORD=change-this-to-a-long-random-password

# ---- Application ----------------------------------------------------
# Keep this false anywhere the site is reachable from the internet.
# When true, PHP stack traces are printed to the browser.
APP_DEBUG=false
